{
  "name": "GoGovSG",
  "version": "1.88.1",
  "description": "Link shortener for Singapore government.",
  "main": "src/server/index.js",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc && webpack --mode production",
    "postbuild": "copyfiles -u 1 src/server/views/**/* build && copyfiles -u 4 src/server/modules/qr/assets/**/* build/server/modules/qr",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "start": "node -r dotenv/config build/server/index.js",
    "client-dev": "webpack serve --mode development --host 0.0.0.0 --devtool inline-source-map --hot",
    "server-dev": "ts-node-dev --poll --respawn --transpile-only --inspect=0.0.0.0 -r dotenv/config -- src/server/index.ts",
    "docker-dev": "concurrently \"npm run server-dev\" \"npm run client-dev\"",
    "dev": "docker compose -f docker-compose.yml up --build",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:e2e": "testcafe chrome ./test/end-to-end --app \"npm run dev\" --app-init-delay 270000",
    "test:e2e-headless": "testcafe chrome:headless ./test/end-to-end --app \"npm run dev\" --app-init-delay 270000 --hostname localhost",
    "test:integration": "jest --config=./test/integration/jest.config.js ./test/integration",
    "cz": "git-cz",
    "release": "./release.sh",
    "prepare": "husky install",
    "db:migrate:new": "npx sequelize-cli migration:generate --name",
    "db:migrate:test": "source .env.test && npx sequelize-cli db:migrate",
    "db:migrate:go:prod": "source .env.go.prod && npx sequelize-cli db:migrate",
    "db:migrate:go:staging": "source .env.go.staging && npx sequelize-cli db:migrate",
    "db:migrate:go:test": "source .env.go.test && npx sequelize-cli db:migrate",
    "db:migrate:edu:prod": "source .env.edu.prod && npx sequelize-cli db:migrate",
    "db:migrate:edu:staging": "source .env.edu.staging && npx sequelize-cli db:migrate",
    "db:migrate:edu:test": "source .env.edu.test && npx sequelize-cli db:migrate",
    "db:migrate:health:prod": "source .env.health.prod && npx sequelize-cli db:migrate",
    "db:migrate:health:staging": "source .env.health.staging && npx sequelize-cli db:migrate",
    "db:migrate:health:test": "source .env.health.test && npx sequelize-cli db:migrate"
  },
  "author": "Open Government Products, GovTech Singapore (https://open.gov.sg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengovsg/GoGovSG.git"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "@datadog/browser-rum": "^4.15.0",
    "@material-ui/core": "^4.11.4",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@opengovsg/validators": "^1.4.1",
    "@types/papaparse": "^5.3.5",
    "archiver": "^5.3.2",
    "aws-sdk": "^2.1354.0",
    "babel-polyfill": "^6.26.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "chart.js": "^2.9.4",
    "cheerio": "^1.0.0-rc.10",
    "classnames": "^2.3.1",
    "cloudmersive-virus-api-client": "^1.2.2",
    "connect-redis": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.1",
    "copy-to-clipboard": "^3.3.1",
    "core-js": "^3.49.0",
