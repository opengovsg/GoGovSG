    "minimatch": "^10.2.6",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "morgan": "^1.11.0",
    "nanoid": "^3.3.17",
    "nodemailer": "^9.0.4",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pg-connection-string": "^2.14.0",
    "qrcode": "^1.5.4",
    "react": "^17.0.2",
    "react-chartjs-2": "^2.11.2",
    "react-dom": "^17.0.2",
    "react-ga": "^3.3.1",
    "react-i18next": "^17.0.11",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "react-typed": "^2.0.12",
    "redis": "^3.1.2",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "^0.14.1",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "ua-parser-js": "^2.0.10",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.0",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@datadog/datadog-ci": "5.22.0",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/chart.js": "^2.9.41",
    "@types/cloudmersive-virus-api-client": "^1.1.4",
    "@types/connect-redis": "0.0.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/d3": "^6.7.8",
    "@types/express": "^4.17.25",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.19.0",
    "@types/file-saver": "^2.0.7",
    "@types/history": "^4.7.11",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@types/redis": "^2.8.32",
    "@types/redis-mock": "^0.17.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/upng-js": "^2.1.5",
    "@types/validator": "^13.15.10",
    "auto-changelog": "^2.6.0",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "csv-parse": "^7.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "form-data": "^4.0.6",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsqr": "^1.4.0",
    "lint-staged": "^17.3.0",
    "node-mocks-http": "^1.18.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-plugin-eslint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "path-browserify": "^1.0.1",
    "querystring-es3": "^0.2.1",
    "redis-mock": "^0.56.3",
    "sequelize-cli": "6.6.5",
    "sequelize-mock": "^0.10.2",
    "serverless-plugin-include-dependencies": "^6.1.1",
    "supertest": "^7.2.2",
    "swc-loader": "^0.2.7",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "upng-js": "^2.1.0",
    "url": "^0.11.4",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "lint-staged": {
    "**/*.(js|jsx|ts|tsx)": [
      "oxlint --type-aware --fix",
      "oxfmt --write"
    ]
  },
  "overrides": {
    "@types/node": "$@types/node"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
