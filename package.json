{
  "name": "GoGovSG",
  "version": "1.88.1",
  "description": "Link shortener for Singapore government.",
  "private": true,
  "main": "src/server/index.js",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc && NODE_OPTIONS='-r tsx/cjs' webpack --mode production",
    "postbuild": "copyfiles -u 1 src/server/views/**/* build && copyfiles -u 4 src/server/modules/qr/assets/**/* build/server/modules/qr",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "start": "node -r dotenv/config build/server/index.js",
    "client-dev": "NODE_OPTIONS='-r tsx/cjs' webpack serve --mode development --host 0.0.0.0 --devtool inline-source-map --hot",
    "server-dev": "tsx watch --inspect=0.0.0.0 -r dotenv/config src/server/index.ts",
    "docker-dev": "concurrently \"pnpm run server-dev\" \"pnpm run client-dev\"",
    "dev": "docker compose -f docker-compose.yml up --build",
    "dev:server-only": "docker compose -f docker-compose.yml -f docker-compose.server-only.yml up --build",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:e2e": "playwright test --headed",
    "test:e2e-headless": "playwright test",
    "test:integration": "jest --config=./test/integration/jest.config.js",
    "cz": "git-cz",
    "release": "./release.sh",
    "prepare": "husky",
    "db:migrate:new": "pnpm exec sequelize-cli migration:generate --name",
    "db:migrate:test": "source .env.test && pnpm exec sequelize-cli db:migrate",
    "db:migrate:go:prod": "source .env.go.prod && pnpm exec sequelize-cli db:migrate",
    "db:migrate:go:staging": "source .env.go.staging && pnpm exec sequelize-cli db:migrate",
    "db:migrate:go:test": "source .env.go.test && pnpm exec sequelize-cli db:migrate",
    "db:migrate:edu:prod": "source .env.edu.prod && pnpm exec sequelize-cli db:migrate",
    "db:migrate:edu:staging": "source .env.edu.staging && pnpm exec sequelize-cli db:migrate",
    "db:migrate:edu:test": "source .env.edu.test && pnpm exec sequelize-cli db:migrate",
    "db:migrate:health:prod": "source .env.health.prod && pnpm exec sequelize-cli db:migrate",
    "db:migrate:health:staging": "source .env.health.staging && pnpm exec sequelize-cli db:migrate",
    "db:migrate:health:test": "source .env.health.test && pnpm exec sequelize-cli db:migrate"
  },
  "author": "Open Government Products, GovTech Singapore (https://open.gov.sg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengovsg/GoGovSG.git"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-sqs": "^3.1103.0",
    "@aws-sdk/lib-storage": "^3.1103.0",
    "@datadog/browser-rum": "^7.7.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/lab": "4.0.0-alpha.61",
    "@opengovsg/validators": "^1.4.1",
    "@redux-devtools/extension": "^3.3.0",
    "@types/papaparse": "^5.5.2",
    "archiver": "^8.0.0",
    "babel-polyfill": "^6.26.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.6",
    "chart.js": "^2.9.4",
    "cheerio": "^1.2.0",
    "classnames": "^2.5.1",
    "cloudmersive-virus-api-client": "^1.4.0",
    "connect-redis": "^6.1.3",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "core-js": "^3.49.0",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dd-trace": "^6.8.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.22.2",
    "express-fileupload": "^1.5.2",
    "express-joi-validation": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "file-saver": "^2.0.5",
    "file-type": "^22.0.1",
    "helmet": "^4.6.0",
    "history": "^4.10.1",
    "hot-shots": "^17.1.0",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "inversify": "^7.11.0",
