    "@types/file-saver": "^2.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.170",
    "@types/morgan": "^1.9.3",
    "@types/node": "^15.14.0",
    "@types/qrcode": "^1.4.0",
    "@types/react-dom": "^17.0.2",
    "@types/react-redux": "^7.1.16",
    "@types/react-router-dom": "^5.1.7",
