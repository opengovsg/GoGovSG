    "husky": "^7.0.0",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "lint-staged": "^11.0.0",
    "node-mocks-http": "^1.10.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-plugin-eslint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "path-browserify": "^1.0.1",
    "redis-mock": "^0.56.3",
    "sequelize-mock": "^0.10.2",
    "serverless-plugin-include-dependencies": "^5.0.0",
    "supertest": "^6.1.3",
    "testcafe": "3.7.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "upng-js": "^2.1.0",
    "url": "^0.11.4",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.7.2",
    "webpack-dev-server": "^4.15.1"
  },
  "lint-staged": {
    "**/*.(js|jsx|ts|tsx)": ["oxlint --type-aware --fix", "oxfmt --write"]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
